###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=REPLACE_WITH_RANDOM_32_HEX
###< symfony/framework-bundle ###

###> symfony/webapp-meta ###
MESSENGER_TRANSPORT_DSN=doctrine://default?queue_name=MessageExtract
MESSENGER_TRANSPORT_SEND=doctrine://default?queue_name=MessageSend
MESSENGER_FAILED_DSN=doctrine://default?queue_name=failed
###< symfony/webapp-meta ###

###> Основная БД приложения (Doctrine). Локальная БД из docker compose (service "db"). ###
DATABASE_URL="postgresql://recono:recono@db:5432/recono?serverVersion=16&charset=utf8"

###> БД процессинга (App\Service\Connection\Pool). Для локальной разработки — та же БД. ###
###> В проде задайте реальные значения в .env.local. ###
PROCESSING_DB_HOST=db
PROCESSING_DB_PORT=5432
PROCESSING_DB_NAME=recono
PROCESSING_DB_USER=recono
PROCESSING_DB_PASSWORD=recono
PROCESSING_DB_HOST_PROD=db
PROCESSING_DB_PORT_PROD=5432
PROCESSING_DB_NAME_PROD=recono
PROCESSING_DB_USER_PROD=recono
PROCESSING_DB_PASSWORD_PROD=recono

###> API процессинга и учётные данные (секреты — задайте в .env.local) ###
PROCESSING_API_URL=
PROCESSING_LOGIN=
PROCESSING_PASSWORD=
PROCESSING_ENCRYPTION_KEY=

###> Почта (секреты — задайте в .env.local) ###
MAILER_DSN=null://null
MAILER_FROM=

###> Telegram-уведомления (секреты — задайте в .env.local) ###
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

###> IMAP для выгрузки реестров провайдера из почты (секреты — задайте в .env.local) ###
IMAP_HOST=
IMAP_PORT=993
IMAP_LOGIN=
IMAP_PASSWORD=
IMAP_FOLDER_PAYMENTS=INBOX/payments
IMAP_FOLDER_PAYOUTS=INBOX/payouts
IMAP_FOLDER_SAVED=INBOX/saved
# Проверка SSL-сертификата IMAP (0 — как в старом python-скрипте, 1 — включить проверку)
IMAP_SSL_VERIFY=0

###> Каталоги для реестров провайдера ###
REG_TEMP=/registry/temp/
REG_PROVIDER=/registry/provider/

IN=/registry/
OUT=/registry/out/
OUT_REG_DIR=/registry/out/
OUT_ACT_DIR=/registry/act/

###> dev ###
VAR_DUMPER_SERVER=127.0.0.1:9912
