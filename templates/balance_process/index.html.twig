{% extends 'backend.html.twig' %}

{% block title %}Балансы{% endblock %}

{% block body %}
    {% for message in app.flashes('notification') %}
        <div class="alert alert-info alert-dismissible fade show">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"><span aria-hidden="true"></span></button>
        </div>
    {% endfor %}
    <div class="row">
        <div class="row pt-3 pb-3">
            <div class="col-5">
                <label style="font-weight: bold">Расчет балансов партнерам</label>
            </div>
        </div>
        <div class="col">
            {% include 'balance_process/filter.html.twig' %}
{#            {{ dump(data) }}#}
            {% if data|length > 0 %}
            <table class="table table-bordered table-striped">
                {% for date, item in data %}
                    {% if item.processIds is defined %}
                    <tr>
                        <td colspan="10">
                            <div class="row">
                                <div class="col-6">
                                    <span style="font-weight:bold">{{ date }}</span>
                                </div>
{#                                {% if item.created %}#}
{#                                    <div class="col-6 d-flex justify-content-end">#}
{#                                        <div class="m-lg-1">#}
{#                                            <a href="{{ path('app_balance_process_restart_check', {date:date}) }}" class="btn btn-outline-primary">Проверить данные</a>#}
{#                                        </div>#}
{#                                        <div class="m-lg-1">#}
{#                                            <a href="{{ path('app_balance_process_restart_create', {date:date}) }}" class="btn btn-outline-danger">Пересоздать процессы</a>#}
{#                                        </div>#}
{#                                    </div>#}
{#                                {% endif %}#}
{#                                {% if item.checked %}#}
{#                                    <div class="col-6 d-flex justify-content-end">#}
{#                                        <div class="m-lg-1">#}
{#                                            <a href="{{ path('app_balance_process_finish', {date:date}) }}" class="btn btn-outline-primary">Отправить данные</a>#}
{#                                        </div>#}
{#                                    </div>#}
{#                                {% endif %}#}
{#                                {% if item.new %}#}
{#                                    {% if item.new %}#}
{#                                    <div class="col-6 d-flex justify-content-end">#}
{#                                        <div class="m-lg-1">#}
{#                                            <a href="{{ path('app_balance_process_restart_create', {date:date}) }}" class="btn btn-outline-danger">Пересоздать процессы</a>#}
{#                                        </div>#}
{#                                    </div>#}
{#                                    {% endif %}#}
{#                                {% endif %}#}
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <th>Процесс</th>
                        <th>ID партнера</th>
                        <th>ID кошелька</th>
                        <th>Мерчант/Провайдер</th>
                        <th>Оборот <span style="font-size: small">(amount)</span></th>
                        <th>Было <span style="font-size: small">(counter_in)</span></th>
                        <th>Выставить <span style="font-size: small">(_amount)</span></th>
                        <th>Стало <span style="font-size: small">(counter_in)</span></th>
                        <th>Статус</th>
                        <th>Действие</th>
                    </tr>


                    {% for id, record in item.processIds %}
                        <tr>
                            <td>
                                <div>{{ record.id }}</div>
                            </td>
                            <td>
                                <div>
                                    {% if record.getBalanceConfigId().type != 'provider'%}
                                        {{ record.getBalanceConfigId().partnerId }}
                                    {% endif %}
                                </div>
                            </td>
                            <td>
                                <div>{{ record.getBalanceConfigId().walletId }}</div>
                            </td>
                            <td>
                                <div>{{ record.getBalanceConfigId().partnerName }}</div>
                            </td>
                            <td>
                                <div>{{ record.totalAmount }}</div>
                            </td>
                            <td>
                                <div>{{ record.counterInWas }}</div>
                            </td>
                            <td>
                                <div>{{ record.counterInBe }}</div>
                            </td>
                            <td>
                                <div>{{ record.counterInWas + record.counterInBe }}</div>
                            </td>
                            <td>
                                {% if record.status in {0:'finished'} %}
                                    <i class="fa fa-check" style="color: green"></i>
                                    {{ record.status }}
                                {% endif%}
                                {% if record.status in {0:'creating', 1:'finishing', 2:'checking'} %}
                                    <span style="color: lightseagreen">
                                    {{ record.status }}...
                                    </span>{% endif%}
                                {% if record.status in {0:'created'} %}{{ record.status }}{% endif%}
                                {% if record.status in {0:'checked'} %}
                                    <span style="color: green">
                                    {{ record.status }}
                                    </span>
                                {% endif%}
                                {% if record.status in {0:'error', 1:'new'} %}
                                    <span style="color: darkred">
                                    <a class="dropdown-item" href="{{ path('app_balance_process_error') }}">{{ record.status }}</a>
                                    </span>
                                {% endif%}
                            </td>
                            <td>
                                {% if record.status == 'created' %}
                                    <a href="{{ path('app_balance_process_restart_check', {date: date, process: record.id}) }}" class="hint-target me-1"><i class="fa fa-check"></i></a>
                                    <div class="hint">Проверить данные</div>
                                    <a href="{{ path('app_balance_process_restart_create', {date: date, id: record.getBalanceConfigId().id}) }}" class="hint-target me-1"><i class="fa fa-redo"></i></a>
                                    <div class="hint">Пересоздать процесс</div>
                                    <a href="{{ path('app_balance_process_cancel', {date:date, process: record.id}) }}" class="hint-target"><i class="fa fa-cancel"></i></a>
                                    <div class="hint">Удалить процесс</div>
                                {% endif %}
                                {% if record.status == 'checked' %}
                                    <a href="{{ path('app_balance_process_finish', {date:date, process: record.id}) }}" class="hint-target me-1"><i class="fa fa-rocket"></i></a>
                                    <div class="hint">Отправить балансы</div>
                                    <a href="{{ path('app_balance_process_cancel', {date:date, process: record.id}) }}" class="hint-target"><i class="fa fa-cancel"></i></a>
                                    <div class="hint">Удалить процесс</div>
                                {% endif %}
                                {% if record.status == 'new' %}
                                    <a href="{{ path('app_balance_process_restart_create', {date: date, id: record.getBalanceConfigId().id}) }}" class="hint-target me-1"><i class="fa fa-redo"></i></a>
                                    <div class="hint">Пересоздать процесс</div>
                                    <a href="{{ path('app_balance_process_cancel', {date:date, process: record.id}) }}" class="hint-target"><i class="fa fa-cancel"></i></a>
                                    <div class="hint">Удалить процесс</div>
                                {% endif %}
                                {% if item.commandNotVerified is defined %}
                                    <a href="{{ path('app_balance_process_reload', {date:date, process: record.id}) }}" class="hint-target"><i class="fa fa-warning"></i></a>
                                    <div class="hint">Есть не сверенный реестр, можно пере считать баланс</div>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                    {% endif %}
                {% endfor %}
            </table>
            {% else %}
                <p>Записей не найдено</p>
            {% endif %}
        </div>
    </div>
{% endblock %}
