{% extends "backend.html.twig" %}

{% block title %}{% if user_exists %}Edit{% else %}Create{% endif %}{% endblock %}

{% block body %}
{#        {{ dump(user_form) }}#}
    {% for message in app.flashes('notification') %}
        <div class="alert alert-warning alert-dismissible fade show">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"><span aria-hidden="true"></span></button>
        </div>
    {% endfor %}
    {{ form_start(user_form) }}
    <h1 class="fw-normal my-4">
        {% if user_exists %}Редактирование{% else %}Создание новых{% endif %} настроек для отправки реестров
        <button class="btn btn-sm btn-outline-primary float-end" type="submit">сохранить</button>
    </h1>
    <div class="row">
        <div class="col-12 col-lg-6">
            {{ form_row(user_form.slug) }}
            {{ form_row(user_form.email_to) }}
            {% if user_form.email_to.vars.value %}
                {% for reg in user_form.email_to.vars.value %}
                    {% if reg %}
                        {{ reg }}
                        <br>
                    {% endif %}
                {% endfor %}

            {% endif %}
            {{ form_row(user_form.email_cc) }}
            {{ form_row(user_form.type) }}
            {{ form_row(user_form.format) }}
            {{ form_row(user_form.description) }}
            {{ form_row(user_form.is_active) }}
            {{ form_row(user_form.provider) }}
            {{ form_row(user_form.terminal) }}
            {% if user_form.terminal.vars.value %}
                {% for reg in user_form.terminal.vars.value %}
                    {% if reg %}
                        {{ reg }}
                        <br>
                    {% endif %}
                {% endfor %}

            {% endif %}
            {{ form_row(user_form.partner_id) }}
        </div>
        <div class="col-12 col-lg-6">
        </div>
    </div>
    {{ form_end(user_form) }}
{% endblock %}
