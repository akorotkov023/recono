{{ form_start(filter) }}
<div class="accordion mb-4" id="accordionSearch">
    <div class="accordion-item">
        <h2 class="accordion-header" id="headingOne">
            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                Фильтры для поиска
            </button>
        </h2>
        <div id="collapseOne" class="accordion-collapse collapse show" aria-labelledby="headingOne" data-bs-parent="#accordionSearch">
            <div class="accordion-body">
                <div class="row">
                    <div class="container-fluid">
                        <div class="row">

                            <div class="col-12 col-lg-4">
                                {{ form_row(filter.selector) }}
                                {{ form_row(filter.tx_id) }}
                                {{ form_row(filter.btn_tx_id) }}
                            </div>
                            <div class="col-3">
                            </div>
                            <div class="col-4">
                                <div class="row">
                                    <div class="col">
                                        {{ form_row(filter.start) }}
                                    </div>
                                    <div class="col">
                                        {{ form_row(filter.any_card) }}
                                    </div>

                                    <div class="row">
                                        {{ form_row(filter.btn_any_card) }}
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{{ form_end(filter) }}
