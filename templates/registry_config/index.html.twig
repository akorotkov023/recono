{% extends 'backend.html.twig' %}

{% block title %}Настройки{% endblock %}

{% block body %}
    <div class="row pt-3 pb-3">
        <div class="col-5">
            <label style="font-weight: bold">Настройки команд провайдерских реестров</label>
        </div>
    </div>
    <div class="row pb-1">
        <div class="col">
            <a href="{{ path('app_registry_config_create') }}"><i class="fa fa-plus-circle"></i> Создать настройку</a>
        </div>
    </div>
{#        {{ dump(settings) }}#}
    <div class="row">
        <div class="col">
            {% if settings|length > 0 %}
                <table class="table table-striped">
                    <tr>
                        <th>{% trans %}ID{% endtrans %}</th>
                        <th>{% trans %}Провайдер{% endtrans %}</th>
                        <th>{% trans %}Название реестра{% endtrans %}</th>
                        <th>{% trans %}Банк{% endtrans %}</th>
                        <th>{% trans %}Описание{% endtrans %}</th>
                        <th>{% trans %}Активность{% endtrans %}</th>
                        <th>{% trans %}Действие{% endtrans %}</th>
                    </tr>
                    {% for user in settings %}
                        <tr
                                {% if user.isActive == 1 %}
                                    style="background-color: rgba(163,255,163,0.2);"
                                {% else %}
                                    style="background-color: rgba(255,0,0,0.05);"
                                {% endif %}
                        >
                            <td>
                                <div>{{ user.id }}</div>
                            </td>
                            <td>
                                <div>{{ user.provider }}</div>
                            </td>
                            <td>
                                <div>{{ user.slug }}</div>
                            </td>
                            <td>
                                <div>{{ user.providerWalletId }}</div>
                            </td>
                            <td>
                                <div>{{ user.description }}</div>
                            </td>
                            <td>
                                <div>{{ user.isActive? 'true':'false' }}</div>
                            </td>
                            <td>
                                <a href="{{ path('app_registry_config_edit', {id:user.id}) }}" class="hint-target me-3"><i class="fa fa-user-edit"></i></a>
                                <div class="hint">Редактировать</div>
                                <a href="{{ path('app_registry_config_delete', {id:user.id}) }}" class="hint-target"><i class="fa fa-user-minus"></i></a>
                                <div class="hint">Удалить</div>
                            </td>
                        </tr>
                    {% endfor %}
                </table>
            {% else %}
                <p>Записей не найдено</p>
            {% endif %}
        </div>
    </div>
{% endblock %}


