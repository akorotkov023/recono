{% extends 'base.html.twig' %}

{% block title %}Ошибка{% endblock %}

{% block body %}
    <div class="container d-flex align-items-center justify-content-center py-4">
        <div class="alert alert-danger mt-3">Ошибка: {{ error }}</div>
    </div>
    <div class="container d-flex align-items-center justify-content-center py-4">
        <div class="col-2">
            <a href="{{ path('app_logout') }}"
               class="btn btn-outline-primary form-control mb-3"
               type="submit">
                <i class="fa fa-door-closed"></i> Назад
            </a>
        </div>
    </div>
{% endblock %}
